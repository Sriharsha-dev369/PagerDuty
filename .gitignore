# Dependencies (any subproject)
**/node_modules/

# Build output
**/dist/
**/build/

# Environment / secrets
.env
**/.env
**/.env.local

# Logs
*.log
npm-debug.log*

# OS junk
.DS_Store
Thumbs.db

# VS Code: ignore personal config, but keep shared project settings
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
